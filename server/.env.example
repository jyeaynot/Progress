PORT=4000
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
# Optional if you want to override the JWKS URL.
# SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json

# Local development
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mao_talacogon

# Supabase recommended for this project:
# Use the session pooler or direct connection from your Supabase Connect panel.
# SUPABASE_DB_URL=postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@aws-0-<region>.pooler.supabase.com:5432/postgres
# or
# SUPABASE_DB_URL=postgresql://postgres:[YOUR-PASSWORD]@db.<project-ref>.supabase.co:5432/postgres?sslmode=require
SUPABASE_DB_URL=
DATABASE_SSL=true

PGSSLMODE=disable
PGPOOL_MAX=10
PGPOOL_IDLE_MS=30000
PGPOOL_CONNECT_MS=10000
